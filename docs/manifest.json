{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.21/MicrosoftTeams.schema.json",
  "id": "b6b1674a-2dca-4f36-9255-7036e6e9023f",
  "manifestVersion": "1.21",
  "version": "1.0.0.7",
  "name": {
    "short": "Confirm-Address(for Local)",
    "full": "Confirm-Address for Outlook (for Local Debug)"
  },
  "description": {
    "short": "メール送信前に、送信先メールアドレス・添付ファイル名・本文冒頭を確認します。",
    "full": "Outlook の送信前確認（宛先・添付名・本文冒頭）を行います。ローカルデバッグ用構成です。"
  },
  "developer": {
    "name": "Keiji Momose",
    "websiteUrl": "https://github.com/beatkz/confirm-address-outlook-js",
    "privacyUrl": "https://github.com/beatkz/confirm-address-outlook-js/blob/main/README.md",
    "termsOfUseUrl": "https://github.com/beatkz/confirm-address-outlook-js/blob/main/README.md"
  },
  "icons": {
    "outline": "assets/img/ConfirmAddress-Outline.png",
    "color": "assets/img/ConfirmAddress-192x192.png"
  },
  "accentColor": "#232859",
  "localizationInfo": {
    "defaultLanguageTag": "ja-jp",
    "additionalLanguages": []
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "MailboxItem.Read.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "validDomains": ["https://localhost:3000"],
  "extensions": [
    {
      "requirements": {
        "scopes": ["mail"],
        "capabilities": [
          { "name": "Mailbox", "minVersion": "1.9" }
        ]
      },
      "runtimes": [
        {
          "requirements": {
            "capabilities": [
              { "name": "Mailbox", "minVersion": "1.9" }
            ]
          },
          "id": "SettingsRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/settings.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "SettingsRuntimeShow",
              "type": "openPage",
              "pinnable": false,
              "view": "dashboard"
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              { "name": "Mailbox", "minVersion": "1.9" }
            ]
          },
          "id": "AutorunRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/bgevent.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "onMessageSendHandler",
              "type": "executeFunction",
              "displayName": "onMessageSendHandler"
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              { "name": "Mailbox", "minVersion": "1.9" }
            ]
          },
          "id": "SendConfirmRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/capopup.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowSendConfirm",
              "type": "openPage",
              "pinnable": false,
              "view": "confirm"
            }
          ]
        }
      ],
      "autoRunEvents": [
        {
          "requirements": {
            "capabilities": [
              { "name": "Mailbox", "minVersion": "1.9" }
            ],
            "scopes": ["mail"]
          },
          "events": [
            {
              "type": "messageSending",
              "actionId": "onMessageSendHandler",
              "options": { "sendMode": "softBlock" }
            }
          ]
        }
      ],
     "ribbons": [
        {
          "contexts": ["mailCompose"],
          "tabs": [
            {
              "builtInTabId": "TabMessage",
              "groups": [
                {
                  "id": "msgComposeGroup2",
                  "label": "Confirm-Address",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/img/ConfirmAddress-16x16.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "msgComposeOpenPaneButton2",
                      "type": "button",
                      "label": "設定",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/img/ConfirmAddress-16x16.png"
                        }
                      ],
                      "supertip": {
                        "title": "設定を表示",
                        "description": "このアドインの設定を表示します。"
                      },
                      "actionId": "SettingsRuntimeShow"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}