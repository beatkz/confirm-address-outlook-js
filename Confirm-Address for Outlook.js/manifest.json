{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.21/MicrosoftTeams.schema.json",
  "id": "5ab14cd7-dbe1-4d20-ab4c-7368e9e25e16",
  "manifestVersion": "1.21",
  "version": "0.1.0",
  "name": {
    "short": "Confirm-Address for Outlook.js",
    "full": "Confirm-Address for Outlook.js"
  },
  "description": {
    "short": "送信前チェック",
    "full": "メールの送信前に、受信者のメールアドレス・添付ファイル名・本文冒頭を確認します。"
  },
  "developer": {
    "name": "Keiji Momose",
    "websiteUrl": "https://github.com/beatkz/confirm-address-outlook-js",
    "privacyUrl": "https://github.com/beatkz/confirm-address-outlook-js/blob/main/README.md",
    "termsOfUseUrl": "https://github.com/beatkz/confirm-address-outlook-js/blob/main/README.md"
  },
  "icons": {
    "outline": "assets/ConfirmAddress-Outline.png",
    "color": "assets/ConfirmAddress-192x192.png"
  },
  "accentColor": "#232859",
  "localizationInfo": {
    "defaultLanguageTag": "ja-jp",
    "additionalLanguages": []
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "MailboxItem.Read.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "validDomains": ["github.com", "localhost"],
  "extensions": [
    {
      "requirements": {
        "scopes": ["mail"],
        "capabilities": [
          {
            "name": "Mailbox",
            "minVersion": "1.15"
          }
        ]
      },
      "runtimes": [
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.14"
              }
            ]
          },
          "id": "SettingsRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/settings.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "SettingsRuntimeShow",
              "type": "openPage",
              "pinnable": false,
              "view": "dashboard"
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.14"
              }
            ]
          },
          "id": "AutorunRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/bgevent.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "uniqueMessageSendHandler",
              "type": "executeFunction",
              "displayName": "uniqueMessageSendHandler"
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.12"
              }
            ]
          },
          "id": "SendConfirmRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/confirm.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowSendConfirm",
              "type": "openPage",
              "pinnable": false,
              "view": "confirm"
            }
          ]
        }
      ],
      "autoRunEvents": [
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.12"
              }
            ],
            "scopes": ["mail"]
          },
          "events": [
            {
              "type": "messageSending",
              "actionId": "uniqueMessageSendHandler",
              "options": {
                "sendMode": "softBlock"
              }
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": ["mailCompose"],
          "tabs": [
            {
              "builtInTabId": "TabMessage",
              "groups": [
                {
                  "id": "msgComposeGroup2",
                  "label": "Confirm-Address",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/ConfirmAddress-16x16.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "msgComposeOpenPaneButton2",
                      "type": "button",
                      "label": "設定",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/ConfirmAddress-16x16.png"
                        }
                      ],
                      "supertip": {
                        "title": "設定を表示",
                        "description": "このアドインの設定を表示します。"
                      },
                      "actionId": "SettingsRuntimeShow"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
