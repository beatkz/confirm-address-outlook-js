{
  "name": "confirm-address-outlook-js",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/beatkz/confirm-address-outlook-js.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "outlook",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "npm run lint:fix && npm run type-check && vite build --mode production",
    "build:dev": "npm run lint:fix && npm run type-check && vite build --mode development",
    "dev-server": "vite --port 3000",
    "preview": "vite preview --port 3000",
    "lint": "office-addin-lint check --files \"src/**/*.{ts,js}\"",
    "lint:fix": "office-addin-lint fix --files \"src/**/*.{ts,js}\"",
    "prettier": "office-addin-lint prettier --files \"src/**/*.{ts,js}\"",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest_local.xml",
    "start:static": "npm run build:dev && vite preview --port 3000",
    "stop": "office-addin-debugging stop manifest_local.xml",
    "validate": "office-addin-manifest validate manifest_local.xml",
    "validate:release": "office-addin-manifest validate manifest_stable.xml"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "esbuild": "^0.28.2",
    "office-ui-fabric-core": "^11.1.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.591",
    "@types/office-runtime": "^1.0.35",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-office-addins": "^4.0.3",
    "office-addin-cli": "^2.0.3",
    "office-addin-debugging": "^6.0.3",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.0.3",
    "office-addin-prettier-config": "^2.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "overrides": {
    "@typescript-eslint/parser": "^8.40.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/typescript-estree": "^8.40.0",
    "@typescript-eslint/utils": "^8.40.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true,
    "keytar@7.9.0": true,
    "@azure/msal-node-extensions@1.5.32": true,
    "@microsoft/m365agentstoolkit-cli@1.1.17": true,
    "fsevents@2.3.3": true
  }
}
